# ------------------------------------------------------------
# x-file-storage-rustfs environment example
# ------------------------------------------------------------
# Usage (zsh / bash):
#   cp .env.example .env
#   set -a
#   source .env
#   set +a
#
# Note:
# Spring Boot does not automatically load .env files by itself.
# You need to export these variables in your shell / IDE / run config.
# ------------------------------------------------------------

# ------------------------------------------------------------
# AWS S3 / x-file-storage configuration
# ------------------------------------------------------------
AWS_ACCESS_KEY_ID=rustfsadmin
AWS_SECRET_ACCESS_KEY=rustfsadmin
AWS_REGION=us-east-1
AWS_S3_BUCKET=demo

# Leave empty for native AWS S3 in most cases.
AWS_S3_ENDPOINT=http://127.0.0.1:9000

# Optional custom CDN / access domain.
AWS_S3_DOMAIN=

# ------------------------------------------------------------
# Presigned download URL configuration
# ------------------------------------------------------------
APP_STORAGE_PRESIGN_EXPIRE_SECONDS=900
APP_STORAGE_PRESIGN_MAX_EXPIRE_SECONDS=604800

# ------------------------------------------------------------
# Local API / smoke test helpers
# ------------------------------------------------------------
API_BASE_URL=http://127.0.0.1:8080
TEST_FILE=/Users/zhi/Documents/code/java/aws-s3-demo/x-file-storage-rustfs/downloads/pexels-userpascal-32488208.jpg
DOWNLOAD_TARGET=./target/downloaded-demo.txt
START_APP=true
ATTACHMENT=true

# ------------------------------------------------------------
# Optional script output locations
# ------------------------------------------------------------
SERVER_LOG=./target/s3-smoke-test-server.log
UPLOAD_RESPONSE_FILE=./target/s3-upload-response.json

